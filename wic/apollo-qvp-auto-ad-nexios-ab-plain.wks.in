#

# Apollo QVP auto-ad-nexios A/B boot disk without dm-verity.
#
# Root slots rawcopy the plain ext4 image so the kernel can mount the
# selected slot directly when the UKI has no initramfs.

part /boot-a --label boot_a --part-name="boot_a" --active --align 1024 --use-uuid --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --source bootimg-efi --sourceparams="loader=${EFI_PROVIDER}" --fstype=vfat --fixed-size=128M
part /boot-b --label boot_b --part-name="boot_b" --align 1024 --use-uuid --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --source bootimg-efi-slot --sourceparams="loader=${EFI_PROVIDER}" --fstype=vfat --fixed-size=128M

part --part-name="misc" --align 1024 --use-uuid --source rawcopy --sourceparams="file=auto-ad-nexios-misc-default.bin" --fstype=none --fixed-size=4M

part /rootro-a --part-name="rootro_a" --align 1024 --use-uuid --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.ext4" --fstype=ext4 --fixed-size=8192M
part /rootro-b --part-name="rootro_b" --align 1024 --use-uuid --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${IMAGE_LINK_NAME}.ext4" --fstype=ext4 --fixed-size=8192M

part /rootrw --label rootrw --part-name="rootrw" --align 1024 --use-uuid --fstype=ext4 --fixed-size=512M
part /data --label data --part-name="data" --align 1024 --use-uuid --fstype=ext4 --fixed-size=4096M

bootloader --ptable gpt --timeout=1 --source bootimg-efi --append="${BOOTLOADER_LINUX_APPEND}"
