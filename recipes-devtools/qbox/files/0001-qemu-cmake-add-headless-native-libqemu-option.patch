From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 6 Jul 2026 02:05:00 +0900
Subject: [PATCH] qemu.cmake: add headless native libqemu option

QBox Apollo QVP uses QEMU as a headless co-simulation backend. The Apollo
aggregate target does not include QBox display or VNC components, and
QemuInstance adds "-display none" when no display component sets a display
argument.

Add a CMake option for recipe-local native libqemu builds to disable SDL,
VNC, and OpenGL configure options. This avoids requiring distro-wide OpenGL
policy only to satisfy a native host tool recipe.

Upstream-Status: Inappropriate [recipe-local native wrapper]
Signed-off-by: Codex <codex@local>
---
diff --git a/qemu.cmake b/qemu.cmake
index 1111111..2222222 100644
--- a/qemu.cmake
+++ b/qemu.cmake
@@ -5,0 +6,3 @@ option(LIBQEMU_BUILD_ALWAYS "Always run the QEMU external project build step" OFF)
+option(LIBQEMU_HEADLESS "Build libqemu without SDL, VNC, or OpenGL UI dependencies" OFF)
+set(LIBQEMU_QEMU_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}" CACHE PATH
+    "QEMU source directory used by the libqemu external project")
@@ -57,0 +61,10 @@ set(QEMU_CONF_ARGS ${QEMU_CONF_ARGS} --libdir=lib)
+if(LIBQEMU_HEADLESS)
+    list(REMOVE_ITEM QEMU_CONF_ARGS
+        --enable-sdl
+        --enable-vnc
+        --enable-vnc-jpeg
+        --enable-opengl)
+    list(APPEND QEMU_CONF_ARGS
+        --disable-sdl --disable-sdl-image --disable-vnc --disable-opengl
+        --disable-gtk)
+endif()
@@ -187,2 +201,2 @@ ExternalProject_Add(qemu
-    SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}
-    CONFIGURE_COMMAND ${CONFIGURE_ENVIRONMENT_VARIABLE} ${CMAKE_CURRENT_SOURCE_DIR}/configure
+    SOURCE_DIR ${LIBQEMU_QEMU_SOURCE_DIR}
+    CONFIGURE_COMMAND ${CONFIGURE_ENVIRONMENT_VARIABLE} ${LIBQEMU_QEMU_SOURCE_DIR}/configure
